{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "allowuserjfs-jpb-dl",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::881273802834:user/JFS-JPB-DSA"
            },
            "Action": [
                "s3:GetObject",
                "s3:ListBucket",
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::jfs-jpb-s3-dsa-dev",
                "arn:aws:s3:::jfs-jpb-s3-dsa-dev/*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:SourceVpce": "vpce-0e9dca1e9dc62d8e2"
                },
                "Bool": {
                    "aws:SecureTransport": "true"
                }
            }
        },
        {
            "Sid": "AllowJFSJPBDataScientistDevWRonDSA",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::881273802834:role/aws-reserved/sso.amazonaws.com/ap-south-1/AWSReservedSSO_JFS-JPB-DataScientist-Dev_a69446c1f82c7741"
            },
            "Action": "*",
            "Resource": [
                "arn:aws:s3:::jfs-jpb-s3-dsa-dev",
                "arn:aws:s3:::jfs-jpb-s3-dsa-dev/*"
            ]
        },
        {
            "Sid": "AllowAccessViaVPCEndpointAndRole",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::881273802834:role/jfs-jpb-s3-dsa"
            },
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:ListBucket",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::jfs-jpb-s3-dsa-dev",
                "arn:aws:s3:::jfs-jpb-s3-dsa-dev/*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:SourceVpce": "vpce-0e9dca1e9dc62d8e2",
                    "aws:PrincipalArn": "arn:aws:iam::881273802834:role/jfs-jpb-s3-dsa"
                },
                "Bool": {
                    "aws:SecureTransport": "true"
                }
            }
        },
        {
            "Sid": "DenyIfNotFromVPCAndRole",
            "Effect": "Deny",
            "Principal": "*",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:ListBucket",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::jfs-jpb-s3-dsa-dev",
                "arn:aws:s3:::jfs-jpb-s3-dsa-dev/*"
            ],
            "Condition": {
                "StringNotEqualsIfExists": {
                    "aws:SourceVpce": "vpce-0e9dca1e9dc62d8e2"
                },
                "StringNotEquals": {
                    "aws:PrincipalArn": [
                        "arn:aws:iam::881273802834:role/jfs-jpb-s3-dsa",
                        "arn:aws:iam::881273802834:user/gkumar@inferyx.com",
                        "arn:aws:iam::881273802834:user/JFS-JPB-DSA",
                        "arn:aws:iam::881273802834:role/aws-reserved/sso.amazonaws.com/ap-south-1/AWSReservedSSO_JFS-JPB-DSA-PII-Users_f551106ef00afa1f",
                        "arn:aws:iam::881273802834:role/aws-reserved/sso.amazonaws.com/ap-south-1/AWSReservedSSO_INFERYX_ADMINS_98408f230207e0ab",
                        "arn:aws:iam::881273802834:role/aws-reserved/sso.amazonaws.com/ap-south-1/AWSReservedSSO_JFS-JPB-DataScientist-Dev_a69446c1f82c7741"
                    ]
                }
            }
        },
        {
            "Sid": "DenyInsecureTransport",
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:*",
            "Resource": [
                "arn:aws:s3:::jfs-jpb-s3-dsa-dev",
                "arn:aws:s3:::jfs-jpb-s3-dsa-dev/*"
            ],
            "Condition": {
                "Bool": {
                    "aws:SecureTransport": "false"
                }
            }
        },
        {
            "Sid": "DenyNonSigV4Requests",
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:*",
            "Resource": [
                "arn:aws:s3:::jfs-jpb-s3-dsa-dev",
                "arn:aws:s3:::jfs-jpb-s3-dsa-dev/*"
            ],
            "Condition": {
                "StringNotEquals": {
                    "s3:SignatureVersion": "AWS4-HMAC-SHA256"
                }
            }
        }
    ]
}