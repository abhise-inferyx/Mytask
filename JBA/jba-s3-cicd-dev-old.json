{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowRWAccessToSpecificUser",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::535614566396:role/jfs-jba-cicd-dev"
