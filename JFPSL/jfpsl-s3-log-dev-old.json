{
    "Version": "2012-10-17",
    "Id": "S3-Console-Auto-Gen-Policy-1749030642001",
    "Statement": [
        {
            "Sid": "S3PolicyStmt-DO-NOT-MODIFY-1749030641915",
            "Effect": "Allow",
            "Principal": {
                "Service": "logging.s3.amazonaws.com"
            },
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::jfs-jfpsl-s3-log/*",
            "Condition": {
                "StringEquals": {
                    "aws:SourceAccount": "556689193548"
                }
            }
        },
        {
            "Sid": "AWSCloudTrailAclCheck20150319-9a0d116e-9032-49fa-908b-84b4bb66ca3f",
            "Effect": "Allow",
            "Principal": {
                "Service": "cloudtrail.amazonaws.com"
            },
            "Action": "s3:GetBucketAcl",
            "Resource": "arn:aws:s3:::jfs-jfpsl-s3-log",
            "Condition": {
                "StringEquals": {
                    "AWS:SourceArn": "arn:aws:cloudtrail:ap-south-1:556689193548:trail/jfs-jfpsl-s3-logs"
                }
            }
        },
        {
            "Sid": "AWSCloudTrailWrite20150319-6c35e278-1a98-4334-976c-de04007b4220",
            "Effect": "Allow",
            "Principal": {
                "Service": "cloudtrail.amazonaws.com"
            },
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::jfs-jfpsl-s3-log/lz/AWSLogs/556689193548/*",
            "Condition": {
                "StringEquals": {
                    "s3:x-amz-acl": "bucket-owner-full-control",
                    "AWS:SourceArn": "arn:aws:cloudtrail:ap-south-1:556689193548:trail/jfs-jfpsl-s3-logs"
                }
            }
        }
    ]
}