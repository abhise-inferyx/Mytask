{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "AllowAccessViaVPCEndpointAndRole",
			"Effect": "Allow",
			"Principal": {
				"AWS": "arn:aws:iam::648268429665:role/JFS-JFS-S3TECReadWriteAccess"
			},
			"Action": [
				"s3:GetObject",
				"s3:PutObject",
				"s3:ListBucket",
				"s3:DeleteObject"
			],
			"Resource": [
				"arn:aws:s3:::jfs-jfs-s3-tec-dev",
				"arn:aws:s3:::jfs-jfs-s3-tec-dev/*"
			],
			"Condition": {
				"StringEquals": {
					"aws:PrincipalArn": "arn:aws:iam::648268429665:role/JFS-JFS-S3TECReadWriteAccess",
					"aws:SourceVpce": "vpce-0d17b415527c18c52"
				},
				"Bool": {
					"aws:SecureTransport": "true"
				}
			}
		},
		{
			"Sid": "DenyIfNotFromVPCAndRole",
			"Effect": "Deny",
			"Principal": "*",
			"Action": [
				"s3:GetObject",
				"s3:PutObject",
				"s3:ListBucket",
				"s3:DeleteObject"
			],
			"Resource": [
				"arn:aws:s3:::jfs-jfs-s3-tec-dev",
				"arn:aws:s3:::jfs-jfs-s3-tec-dev/*"
			],
			"Condition": {
				"StringNotEqualsIfExists": {
					"aws:SourceVpce": "vpce-0d17b415527c18c52"
				},
				"StringNotEquals": {
					"aws:PrincipalArn": "arn:aws:iam::648268429665:role/JFS-JFS-S3TECReadWriteAccess"
				}
			}
		},
		{
			"Sid": "Deny-TECReadWriteAccess",
			"Effect": "Deny",
			"Principal": {
				"AWS": "arn:aws:iam::648268429665:role/JFS-JFS-S3TECReadWriteAccess"
			},
			"Action": "s3:*",
			"Resource": [
				"arn:aws:s3:::jfs-jfs-s3-tec-dev",
				"arn:aws:s3:::jfs-jfs-s3-tec-dev/*"
			],
			"Condition": {
