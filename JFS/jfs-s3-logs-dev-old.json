{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AWSCloudTrailAclCheck20150319-6a604c96-6476-4c53-bd20-beb65248a5be",
            "Effect": "Allow",
            "Principal": {
                "Service": "cloudtrail.amazonaws.com"
            },
            "Action": "s3:GetBucketAcl",
            "Resource": "arn:aws:s3:::jfs-jfs-s3-logs-dev",
            "Condition": {
                "StringEquals": {
                    "AWS:SourceArn": "arn:aws:cloudtrail:ap-south-1:648268429665:trail/JFS-JFS-S3-CloudTrail"
                }
            }
        },
        {
            "Sid": "AWSCloudTrailWrite20150319-26ca84c4-ffc6-4724-85e5-7d0a11d60597",
            "Effect": "Allow",
            "Principal": {
                "Service": "cloudtrail.amazonaws.com"
            },
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::jfs-jfs-s3-logs-dev/lz/AWSLogs/648268429665/*",
            "Condition": {
                "StringEquals": {
                    "AWS:SourceArn": "arn:aws:cloudtrail:ap-south-1:648268429665:trail/JFS-JFS-S3-CloudTrail",
                    "s3:x-amz-acl": "bucket-owner-full-control"
