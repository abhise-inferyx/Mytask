{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowReadWriteAccessWithVPCEndpoint",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::648268429665:role/JFS-JFS-S3DSAReadWriteAccess"
            },
            "Action": [
                "s3:GetObject",
                "s3:ListBucket",
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::jfs-jfs-s3-dsa-dev",
                "arn:aws:s3:::jfs-jfs-s3-dsa-dev/*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:sourceVpce": "vpce-0d17b415527c18c52"
                }
            }
        },
        {
            "Sid": "DenyAllOtherAccessBucketLevel",
            "Effect": "Deny",
            "Principal": {
                "AWS": "arn:aws:iam::648268429665:role/JFS-JFS-S3DSAReadWriteAccess"
            },
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::jfs-jfs-s3-dsa-dev",
            "Condition": {
                "StringNotEquals": {
                    "aws:sourceVpce": "vpce-0d17b415527c18c52"
                }
            }
        },
        {
            "Sid": "DenyAllOtherAccessObjectLevel",
            "Effect": "Deny",
