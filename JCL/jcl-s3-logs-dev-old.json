{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "S3PolicyStmt-DO-NOT-MODIFY-1751961606770",
            "Effect": "Allow",
            "Principal": {
                "Service": "logging.s3.amazonaws.com"
            },
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::jfs-jfl-s3-log-dev/*",
            "Condition": {
                "StringEquals": {
                    "aws:SourceAccount": "337909765540"
                }
            }
        },
        {
            "Sid": "AWSCloudTrailAclCheck20150319-263097b5-b44e-4064-8ee3-367a9477ddca",
            "Effect": "Allow",
            "Principal": {
                "Service": "cloudtrail.amazonaws.com"
            },
            "Action": "s3:GetBucketAcl",
            "Resource": "arn:aws:s3:::jfs-jfl-s3-log-dev",
            "Condition": {
                "StringEquals": {
                    "AWS:SourceArn": "arn:aws:cloudtrail:ap-south-1:337909765540:trail/jfs-jfl-s3-log-dev"
                }
            }
        },
        {
            "Sid": "AWSCloudTrailWrite20150319-b213fa52-cf69-4cdc-b8a8-bb7fe03c90fa",
            "Effect": "Allow",
            "Principal": {
                "Service": "cloudtrail.amazonaws.com"
            },
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::jfs-jfl-s3-log-dev/jfs-jfl-s3-lz-dev/AWSLogs/337909765540/*",
            "Condition": {
                "StringEquals": {
                    "s3:x-amz-acl": "bucket-owner-full-control",
                    "AWS:SourceArn": "arn:aws:cloudtrail:ap-south-1:337909765540:trail/jfs-jfl-s3-log-dev"
                }
            }
        },
        {
            "Sid": "DenyWritesFromSelfToAvoidRecursiveLogging",
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::jfs-jfl-s3-log-dev/*",
            "Condition": {
                "StringEquals": {
                    "aws:SourceArn": "arn:aws:s3:::jfs-jfl-s3-log-dev"
                }
            }
        },
        {
            "Sid": "AWSCloudTrailAclCheck20150319-b54f8f94-6f04-4fef-bfc4-ff77325e0df6",
            "Effect": "Allow",
            "Principal": {
                "Service": "cloudtrail.amazonaws.com"
            },
            "Action": "s3:GetBucketAcl",
            "Resource": "arn:aws:s3:::jfs-jfl-s3-log-dev",
            "Condition": {
                "StringEquals": {
                    "AWS:SourceArn": "arn:aws:cloudtrail:ap-south-1:337909765540:trail/JFS-JFL-S3-CloudTrail"
                }
            }
        },
        {
            "Sid": "AWSCloudTrailWrite20150319-fb377ed5-38bc-4374-97a8-1b6081411973",
            "Effect": "Allow",
            "Principal": {
                "Service": "cloudtrail.amazonaws.com"
            },
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::jfs-jfl-s3-log-dev/CloudTrail/AWSLogs/337909765540/*",
            "Condition": {
                "StringEquals": {
                    "s3:x-amz-acl": "bucket-owner-full-control",
                    "AWS:SourceArn": "arn:aws:cloudtrail:ap-south-1:337909765540:trail/JFS-JFL-S3-CloudTrail"
                }
            }
        },
        {
            "Sid": "AmazonBedrockLogsWrite",
            "Effect": "Allow",
            "Principal": {
                "Service": "bedrock.amazonaws.com"
            },
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::jfs-jfl-s3-log-dev/bedrock/AWSLogs/337909765540/BedrockModelInvocationLogs/*",
            "Condition": {
                "StringEquals": {
                    "aws:SourceAccount": "337909765540"
                },
                "ArnLike": {
                    "aws:SourceArn": "arn:aws:bedrock:ap-south-1:337909765540:*"
                }
            }
        }
    ]
}