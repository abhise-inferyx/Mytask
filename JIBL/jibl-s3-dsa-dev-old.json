{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "allowuserjfs-jibl-dsa",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::607174520731:user/jfs-jibl-dsa"
            },
            "Action": [
                "s3:GetObject",
                "s3:ListBucket",
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::jfs-jibl-s3-dsa-dev",
                "arn:aws:s3:::jfs-jibl-s3-dsa-dev/*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:SourceVpce": "vpce-011cec2f0b2921e26"
                },
                "Bool": {
                    "aws:SecureTransport": "true"
                }
            }
        },
        {
            "Sid": "AllowAccessViaVPCEndpointAndRole",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::607174520731:role/jfs-jibl-s3-dsa"
            },
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:ListBucket",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::jfs-jibl-s3-dsa-dev",
                "arn:aws:s3:::jfs-jibl-s3-dsa-dev/*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:PrincipalArn": [
                        "arn:aws:iam::607174520731:role/jfs-jibl-s3-dsa",
                        "arn:aws:iam::607174520731:role/aws-reserved/sso.amazonaws.com/ap-south-1/AWSReservedSSO_JFS-JIBL-DSA-PII-Users_438101bf1504bbf6"
                    ],
                    "aws:SourceVpce": "vpce-011cec2f0b2921e26"
                },
                "Bool": {
                    "aws:SecureTransport": "true"
                }
            }
        },
        {
            "Sid": "DenyIfPrincipalNotAllowed",
            "Effect": "Deny",
            "Principal": "*",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:ListBucket",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::jfs-jibl-s3-dsa-dev",
                "arn:aws:s3:::jfs-jibl-s3-dsa-dev/*"
            ],
            "Condition": {
                "StringNotEquals": {
                    "aws:PrincipalArn": [
                        "arn:aws:iam::607174520731:role/jfs-jibl-s3-dsa",
                        "arn:aws:iam::607174520731:user/gkumar@inferyx.com",
                        "arn:aws:iam::607174520731:user/jfs-jibl-dsa",
                        "arn:aws:iam::607174520731:role/aws-reserved/sso.amazonaws.com/ap-south-1/AWSReservedSSO_JFS-JIBL-DSA-PII-Users_438101bf1504bbf6"
                    ]
                }
            }
        }
    ]
}