{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AWSCloudTrailAclCheck20150319-22cdcaf7-fb7e-4896-bce5-eee5a67e7dfc",
            "Effect": "Allow",
            "Principal": {
                "Service": "cloudtrail.amazonaws.com"
            },
            "Action": "s3:GetBucketAcl",
            "Resource": "arn:aws:s3:::jfs-jibl-s3-logs",
            "Condition": {
                "StringEquals": {
                    "AWS:SourceArn": "arn:aws:cloudtrail:ap-south-1:607174520731:trail/jfs-jibl-s3-logs"
                }
            }
        },
        {
            "Sid": "AWSCloudTrailWrite20150319-072149d5-06c9-4e0b-b90d-4f562bd4084e",
            "Effect": "Allow",
            "Principal": {
                "Service": "cloudtrail.amazonaws.com"
            },
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::jfs-jibl-s3-logs/AWSLogs/607174520731/*",
            "Condition": {
                "StringEquals": {
                    "AWS:SourceArn": "arn:aws:cloudtrail:ap-south-1:607174520731:trail/jfs-jibl-s3-logs",
                    "s3:x-amz-acl": "bucket-owner-full-control"
                }
            }
        }
    ]
}